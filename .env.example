# --- API endpoint config ---
# Leave VITE_API_BASE EMPTY to call same-origin "/api/..." (uses the Vite dev
# proxy below in dev; in prod serve this build behind the same origin as the API).
# OR set it to your backend's absolute URL (then enable CORS on the backend).
VITE_API_BASE=

# Only used when VITE_API_BASE is empty: where the dev proxy forwards "/api".
VITE_DEV_PROXY_TARGET=http://localhost:8787
